module Zaniah
  interface _Renderable
    def layout_node: () -> Layout::Node?
    def request_layout: (FrameContext context) -> Layout::Node
    def prepaint: (Bounds bounds, Object? state, FrameContext context) -> void
    def paint: (Bounds bounds, Object? state, Object? prepaint, FrameContext context) -> void
  end

  class FrameContext
    attr_reader window: Platform::Headless::Window
    attr_reader scene: Scene
    attr_reader dispatcher: Input::Dispatcher
    attr_reader text_system: TextSystem::_System?
    attr_reader interactivity: Interactivity
    def initialize: (Platform::Headless::Window window) -> void
    def state: [T] (Object key) { () -> T } -> T
    def theme: () -> Theme
    def animator: () -> Animator
  end

  class Element
    include LengthUnits
    attr_reader layout_node: Layout::Node?
    attr_reader parent: _Renderable?
    attr_reader resolved_style: Layout::Style?
    # Child constructors forward their render blocks through super(); ignored here.
    def initialize: () ?{ (*untyped) -> void } -> void
    def child: (_Renderable? element) -> self
    def children: () -> Array[_Renderable]
                | (Array[_Renderable?] elements) -> self
    def style: (**Layout::style_value properties) -> self
    def key: (Object value) -> self
    def identity_key: () -> Object?
    def paint_style: (**Layout::style_value properties) -> self
    def transition: (*Symbol properties, duration: Numeric, ?easing: Symbol | ^(Numeric) -> Numeric) -> self
    def test_id: () -> String?
               | (String value) -> self
    def handlers: () -> Array[Symbol]
    def with_state: [T] () { () -> T } -> self
    def bg: (color color) -> self
    def border_color: (color color) -> self
    def rounded: (radius radius) -> self
    def opacity: (Numeric value) -> self
    def ring: (Numeric width, ?(color?) color, ?Numeric offset) -> self
    def cursor: (Platform::cursor value) -> self
    def focusable: (?tab_index: Integer, ?context: Input::context) ?{ (Input::action) -> bool } -> self
    def focus_handle: () -> Input::FocusHandle?
    def tooltip: (String text) -> self
    def context_menu: (menu items) -> self
    def flex: () -> self
    def flex_row: () -> self
    def flex_col: () -> self
    def items_center: () -> self
    def justify_center: () -> self
    def w_full: () -> self
    def h_full: () -> self
    def flex_1: () -> self
    def overflow_hidden: () -> self
    def hover: (**Layout::style_value properties) ?{ (StyleBuilder) -> void } -> self
    def active: (**Layout::style_value properties) ?{ (StyleBuilder) -> void } -> self
    def focus: (**Layout::style_value properties) ?{ (StyleBuilder) -> void } -> self
    def focus_visible: (**Layout::style_value properties) ?{ (StyleBuilder) -> void } -> self
    def disabled: (?bool value) -> self
                | (**Layout::style_value properties) { (StyleBuilder) -> void } -> self
    def selected: (?bool value) -> self
                | (**Layout::style_value properties) { (StyleBuilder) -> void } -> self
    def w: (dimension value) -> self
    def h: (dimension value) -> self
    def min_w: (dimension value) -> self
    def min_h: (dimension value) -> self
    def max_w: (dimension value) -> self
    def max_h: (dimension value) -> self
    def p: (Layout::style_value value) -> self
    def m: (Layout::style_value value) -> self
    def gap: (dimension value) -> self
    def border: (Layout::style_value value) -> self
    def border_b: (dimension value) -> self
    def on_click: () { (Input::MouseDown, FrameContext) -> void } -> self
    def on_hover: () { (Input::MouseMove, FrameContext) -> void } -> self
    def on_drag: () { (Input::MouseMove, FrameContext) -> void } -> self
    def on_scroll_wheel: () { (Input::ScrollWheel, FrameContext) -> void } -> self
    def on_mouse_down: () { (Input::MouseDown, FrameContext) -> void } -> self
    def on_mouse_up: () { (Input::MouseUp, FrameContext) -> void } -> self
    def request_layout: (FrameContext context) -> Layout::Node
    def prepaint: (Bounds bounds, Object? state, FrameContext context) -> void
    def paint: (Bounds bounds, Object? state, Object? prepaint, FrameContext context) -> void
  end
  class Div < Element
  end
  class Text < Element
    attr_reader text: String
    attr_reader font_size: Numeric
    attr_reader text_color: color
    attr_reader selection: TextSelection?
    def selection=: (TextSelection value) -> TextSelection
    attr_reader buffer: TextBuffer?
    def initialize: (String text, ?size: Numeric, ?color: color, ?font: TextSystem::_Font?, ?wrap: :none | :word | :anywhere, ?line_height: Numeric?, ?letter_spacing: Numeric, ?align: :start | :center | :end | :justify, ?ellipsis: bool, ?kinsoku: :hanging | :push | :none) -> void
    def measured: () { (Numeric width, Numeric height) -> Layout::measurement } -> self
    def on_change: () { (String value) -> void } -> self
    def placeholder: (String text, ?color: color?) -> self
    def secure: (?bool value) -> self
    def wrap: (?:none | :word | :anywhere mode, ?line_height: Numeric?, ?letter_spacing: Numeric, ?align: :start | :center | :end | :justify, ?ellipsis: bool, ?kinsoku: :hanging | :push | :none) -> self
    def selectable: (?bool value) -> self
    def editable: (?TextBuffer? buffer) -> self
  end
  class Image < Element
    def initialize: (String path) -> void
  end
  class Canvas < Element
    def initialize: () { (Bounds, FrameContext) -> void } -> void
  end
  class Overlay < Div
  end
  class Anchored < Div
    def initialize: (anchor: Point, ?offset: Point) -> void
  end
  class UniformList < Element
    attr_accessor scroll_y: Numeric
    attr_reader visible_range: Range[Integer]?
    attr_reader scroll_state: ScrollState
    def initialize: (count: Integer, row_height: Numeric) { (Integer) -> _Renderable } -> void
  end

  class ScrollState
    attr_reader offset: Point
    attr_reader content_size: Size
    attr_reader viewport_size: Size
    attr_reader axis: :vertical | :horizontal | :both
    attr_reader revision: Integer
    def initialize: (?axis: :vertical | :horizontal | :both, ?inertia: bool) -> void
    def update: (content_size: Size | [Numeric, Numeric], viewport_size: Size | [Numeric, Numeric]) -> Point
    def offset=: (Point | Numeric value) -> (Point | Numeric)
    def scroll_by: (Point | Numeric delta) -> (Point | Numeric)
    def scroll_to: (Point | Numeric position, ?animate: bool) -> (Point | Numeric)
    def animation: (animator: Animator, key: Object, duration: Numeric) -> self
    def glide_by: (Point | Numeric delta, animator: Animator, key: Object, ?duration: Numeric) -> void
    def sample_glide: () -> Point
    def preserve_anchor: (Numeric delta) -> (Point | Numeric)
    def at_top?: () -> bool
    def at_bottom?: () -> bool
    def at_left?: () -> bool
    def at_right?: () -> bool
    def max_offset: () -> Point
    def clamp!: () -> Point
    def scroll_rect: (Bounds bounds, ?align: :start | :center | :end | :nearest) -> (Point | Numeric)
  end

  class ScrollView < Element
    attr_reader scroll_state: ScrollState
    attr_reader axis: :vertical | :horizontal | :both
    def initialize: (?axis: :vertical | :horizontal | :both, ?scrollbar: :overlay | :always | :hidden) -> void
    def request_layout: (FrameContext context) -> Layout::Node
    def prepaint: (Bounds bounds, Object? state, FrameContext context) -> void
    def paint: (Bounds bounds, Object? state, Object? prepaint, FrameContext context) -> void
    def scroll_to: (Bounds | Point | Numeric target, ?align: :start | :center | :end | :nearest, ?animate: bool) -> self
  end

  class SVG < Element
    interface _Outline
      def commands: () -> Array[Symbol]
      def coordinates: () -> Array[Float]
      def empty?: () -> bool
      def bounds: () -> [Numeric, Numeric, Numeric, Numeric]
    end
    class Path
      def self.parse: (String source) -> _Outline
      def initialize: (String source) -> void
      def parse: () -> _Outline
    end
    attr_reader width: Numeric
    attr_reader height: Numeric
    attr_reader view_box: Array[Numeric]
    def self.rasterize_outline: (_Outline outline, ?stroke_width: Numeric?) -> [Bounds, GPU::Texture?]
    def self.parse: (String source, ?color: String) -> SVG
    def self.open: (String path, ?color: String) -> SVG
    def initialize: (String source, ?color: String) -> void
    def texture: (?width: Integer, ?height: Integer, ?color: String) -> GPU::Texture
  end

  class List < Element
    attr_reader scroll_y: Float
    attr_reader visible_range: Range[Integer]
    attr_reader heights: HeightIndex
    attr_reader scroll_state: ScrollState
    def initialize: (count: Integer, ?estimated_height: Numeric, ?overscan: Integer) { (Integer) -> _Renderable } -> void
    def scroll_y=: (Numeric value) -> Numeric
    def total_height: () -> Float
    def update_height: (Integer index, Numeric height) -> self
    def scroll_to: (Integer index, ?align: :start | :center | :end | :nearest) -> self
    class HeightIndex
      attr_reader count: Integer
      def initialize: (Integer count, Numeric estimate) -> void
      def []: (Integer index) -> Float
      def update: (Integer index, Numeric height) -> Float
      def prefix: (Integer index) -> Float
      def total: () -> Float
      def index_at: (Numeric y) -> Integer
    end
  end

  module UI
    class Scrollbar < Element
      def initialize: (ScrollState scroll_state, ?axis: :vertical | :horizontal, ?mode: :overlay | :always | :hidden) -> void
      def accessibility_node: (FrameContext? context) -> Accessibility::Node
    end
  end

  class View
    include LengthUnits
    def div: () -> Div
    def text: (String value, ?size: Numeric, ?color: color, ?font: TextSystem::_Font?) -> Text
    def render: (FrameContext | EntityContext[untyped] context) -> Element
    def svg: (String source, ?color: String) -> SVG
    def list: (count: Integer, ?estimated_height: Numeric, ?overscan: Integer) { (Integer) -> Element } -> List
  end
end
